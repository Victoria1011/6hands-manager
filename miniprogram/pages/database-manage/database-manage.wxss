.log-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.log-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.log-label {
  font-size: 24rpx;
  color: #999;
  min-width: 100rpx;
  flex-shrink: 0;
}

.log-value {
  font-size: 24rpx;
  color: #333;
  flex: 1;
  word-break: break-all;
}

.audio-id-value {
  color: #1890ff;
  cursor: pointer;
  text-decoration: underline;
  transition: all 0.3s;
}

.audio-id-value:active {
  color: #096dd9;
  opacity: 0.7;
}

.text-value {
  color: #555;
  line-height: 1.6;
  max-height: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.cost-value {
