/* ppgarden-hosting.wxss */
.container {
  min-height: 100vh;
  background: #f4f5f7;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* ===== 头部 ===== */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2329;
}

.header-actions {
  display: flex;
  gap: 12rpx;
}

.mini-btn {
  margin: 0;
  font-size: 24rpx;
  line-height: 2.2;
  border-radius: 10rpx;
  padding: 0 20rpx;
}

.mini-btn.ghost {
  background: #fff;
  color: #4e5969;
  border: 1rpx solid #dcdfe4;
}

/* ===== 分区标题 ===== */
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  margin: 28rpx 4rpx 16rpx;
}

/* ===== 花园卡片 ===== */
.host-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(31, 35, 41, 0.04);
}

.host-line1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.host-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  max-width: 460rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.host-state {
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  flex-shrink: 0;
}

.host-state.active {
  color: #07c160;
  background: #e8f8ef;
}

.host-state.idle {
  color: #86909c;
  background: #f2f3f5;
}

.host-line2 {
  font-size: 24rpx;
  color: #86909c;
  margin-top: 8rpx;
}

.host-actions {
  margin-top: 18rpx;
  display: flex;
  gap: 12rpx;
}

.act-btn {
  margin: 0;
  font-size: 24rpx;
  padding: 0 20rpx;
  line-height: 2.1;
  border-radius: 10rpx;
  background: #f2f3f5;
  color: #4e5969;
}

.act-btn::after {
  border: none;
}

.act-pause {
  background: #fdeceb;
  color: #fa5151;
}

/* ===== 空状态 / 错误 / 更新时间 ===== */
.empty {
  text-align: center;
  color: #86909c;
  font-size: 26rpx;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.error-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
  font-size: 24rpx;
  color: #fa5151;
  margin-bottom: 12rpx;
}

.updated {
  text-align: center;
  font-size: 22rpx;
  color: #a8abb2;
  margin-top: 24rpx;
}
