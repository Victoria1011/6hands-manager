/* ppgarden-manage.wxss */
.container {
  min-height: 100vh;
  background: #f4f5f7;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* ===== 头部 ===== */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2329;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* ===== Tab 栏 ===== */
.tab-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 16rpx;
  width: 96%;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 6rpx;
  box-shadow: 0 2rpx 10rpx rgba(31, 35, 41, 0.04);
}

.tab {
  font-size: 26rpx;
  color: #4e5969;
  padding: 10rpx 26rpx;
  border-radius: 10rpx;
}

.tab.active {
  background: #07c160;
  color: #fff;
  font-weight: 500;
}

.tab-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.master-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
}

.master-label {
  font-size: 26rpx;
  color: #1f2329;
  font-weight: 500;
}

.mini-btn {
  margin: 0;
  font-size: 24rpx;
  line-height: 2.2;
  border-radius: 10rpx;
  padding: 0 20rpx;
}

.mini-btn.primary {
  background: #07c160;
  color: #fff;
}

.mini-btn.ghost {
  background: #fff;
  color: #4e5969;
  border: 1rpx solid #dcdfe4;
}

.mini-btn.site {
  background: #1677ff;
  color: #fff;
}

/* ===== 提示条 ===== */
.tip-bar {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  background: #eef6ff;
  border: 1rpx solid #d6e8ff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
}

.tip-icon {
  font-size: 26rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #4e6b8a;
  line-height: 1.6;
}

/* ===== 账号卡片 ===== */
.account-list {
  display: flex;
  flex-direction: column;
  width: 100%;
}

.account-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(31, 35, 41, 0.04);
}

/* 标题旁图标按钮（编辑 / 删除） */
.title-icon-btns {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.icon-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 10rpx;
  background: #f2f3f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.icon-btn.icon-danger {
  background: #fdeceb;
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.account-name {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.name-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-badge {
  font-size: 20rpx;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.session-badge.ok {
  color: #07c160;
  background: #e8f8ef;
}

.session-badge.bad {
  color: #fa5151;
  background: #fdeceb;
}

.session-badge.idle {
  color: #86909c;
  background: #f2f3f5;
}

.disabled-badge {
  font-size: 20rpx;
  color: #fa8c16;
  background: #fff7e6;
  border: 1rpx solid #ffd591;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.switch-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.switch-label {
  font-size: 22rpx;
  color: #86909c;
}

.account-sub {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  font-size: 24rpx;
  color: #86909c;
  margin-top: 6rpx;
}

/* 元宝数量徽标 */
.diamond-badge {
  font-size: 22rpx;
  color: #b8860b;
  background: #fff7e6;
  border: 1rpx solid #ffd591;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  flex-shrink: 0;
}

/* 剩余时长徽标 */
.remain-badge {
  font-size: 22rpx;
  color: #1677ff;
  background: #eef6ff;
  border: 1rpx solid #b8d4ff;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  flex-shrink: 0;
}

/* 交易列表入口 */
.trade-link {
  font-size: 22rpx;
  color: #1677ff;
  padding: 2rpx 8rpx;
  flex-shrink: 0;
}

.trade-link-requests {
  color: #07c160;
}

/* ===== 交易列表弹层 ===== */
.trade-panel {
  max-height: 82vh;
  display: flex;
  flex-direction: column;
}

/* 标题栏 + 右上角关闭按钮 */
.trade-head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.trade-title {
  flex: 1;
  margin-bottom: 0;
}

.trade-close {
  position: absolute;
  right: -10rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 34rpx;
  color: #86909c;
  border-radius: 50%;
}

.trade-close:active {
  background: #f2f3f5;
}

.trade-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  font-size: 24rpx;
  color: #4e5969;
  background: #f7f8fa;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 14rpx;
}

/* 求购大厅筛选行 */
.trade-filter {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 8rpx 10rpx;
}

.filter-label {
  font-size: 24rpx;
  color: #4e5969;
}

.filter-switch {
  transform: scale(0.8);
  transform-origin: right center;
}

/* 求购大厅：各花园今日「已卖/剩余可卖」，单行精简 */
.garden-today {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #f7f8fa;
  border-radius: 8rpx;
  padding: 6rpx 12rpx;
  margin-bottom: 10rpx;
  overflow: hidden;
}

.garden-today-title {
  font-size: 18rpx;
  color: #86909c;
  flex-shrink: 0;
}

.garden-today-item {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  font-size: 20rpx;
  white-space: nowrap;
  overflow: hidden;
}

.garden-today-name {
  color: #4e5969;
  max-width: 96rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.garden-today-sold {
  color: #1677ff;
}

.garden-today-sep {
  color: #c9cdd4;
}

.garden-today-rest.on {
  color: #07c160;
  font-weight: 600;
}

.garden-today-rest.zero {
  color: #a8abb2;
}

/* 今日售卖汇总（交易记录 tab） */
.today-overview {
  background: #f7f8fa;
  border-radius: 10rpx;
  padding: 12rpx 18rpx;
  margin-bottom: 14rpx;
}

.today-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.today-title {
  font-size: 22rpx;
  color: #4e5969;
  font-weight: 600;
  flex-shrink: 0;
}

.today-total {
  font-size: 22rpx;
  color: #07c160;
  font-weight: 500;
}

.today-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.today-item {
  font-size: 20rpx;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.today-item.on {
  color: #07c160;
  background: #e8f8ef;
}

.today-item.zero {
  color: #a8abb2;
  background: #f2f3f5;
}

.trade-refresh {
  font-size: 20rpx;
  color: #1677ff;
  flex-shrink: 0;
}

.trade-refresh.busy {
  color: #a8abb2;
}

.trade-scroll {
  flex: 1;
  min-height: 200rpx;
  max-height: 56vh;
}

/* 交易弹层子标签 */
.trade-tabs {
  display: flex;
  gap: 8rpx;
  background: #f2f3f5;
  border-radius: 10rpx;
  padding: 6rpx;
  margin-bottom: 14rpx;
}

.trade-tab {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #4e5969;
  padding: 10rpx 0;
  border-radius: 8rpx;
}

.trade-tab.active {
  background: #fff;
  color: #1f2329;
  font-weight: 600;
}

.trade-accept {
  margin: 0 0 0 auto;
  font-size: 22rpx;
  padding: 0 20rpx;
  line-height: 2;
}

/* 求购：库存行（可卖组数 + 查库存 + 接单） */
.trade-line4 {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx dashed #eef0f3;
}

.trade-quote {
  font-size: 22rpx;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trade-quote-sub {
  font-size: 20rpx;
  color: #1677ff;
  background: #eef6ff;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  flex-shrink: 0;
}

/* 各花园库存明细：横向等分，可接单的账号下方显示接单按钮 */
.garden-stock-list {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 8rpx;
}

.garden-stock-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  background: #f7f8fa;
  border-radius: 8rpx;
  padding: 6rpx 4rpx;
}

.garden-stock-name {
  max-width: 100%;
  font-size: 20rpx;
  color: #4e5969;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.garden-stock-count {
  font-size: 18rpx;
  border-radius: 6rpx;
  padding: 1rpx 8rpx;
  white-space: nowrap;
}

.garden-stock-count.on {
  color: #07c160;
  background: #e8f8ef;
}

.garden-stock-count.zero {
  color: #a8abb2;
  background: #f2f3f5;
}

.garden-accept {
  width: auto;
  margin: 2rpx 0 0;
  font-size: 18rpx;
  padding: 0 16rpx;
  line-height: 1.8;
}

.stock-overview {
  margin-bottom: 12rpx;
}

.stock-error {
  font-size: 20rpx;
  color: #fa5151;
  background: #fff2f0;
  border-radius: 8rpx;
  padding: 10rpx 16rpx;
}

.trade-quote.ok {
  color: #07c160;
  font-weight: 500;
}

.trade-quote.off {
  color: #a8abb2;
}

.trade-quote.busy {
  color: #1677ff;
}

.trade-check {
  font-size: 22rpx;
  color: #1677ff;
  padding: 4rpx 10rpx;
  flex-shrink: 0;
}

.trade-item {
  background: #fff;
  border: 1rpx solid #eef0f3;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 14rpx;
}

.trade-line1 {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.trade-flower {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
}

.trade-quality {
  font-size: 20rpx;
  color: #1677ff;
  background: #eef6ff;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.trade-gain {
  margin-left: auto;
  font-size: 24rpx;
  color: #07c160;
  font-weight: 500;
}

/* 求购状态标记：status / autoMatch / 排队已满 / 买家游戏中 */
.trade-flags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.trade-flag {
  font-size: 20rpx;
  color: #4e5969;
  background: #f2f3f5;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.trade-flag.ok {
  color: #07c160;
  background: #e8f8ef;
}

.trade-flag.off {
  color: #86909c;
  background: #f2f3f5;
}

.trade-flag.warn {
  color: #fa5151;
  background: #fff2f0;
}

.trade-line2 {
  font-size: 22rpx;
  color: #86909c;
  margin-top: 6rpx;
}

.trade-line3 {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.trade-status {
  font-size: 20rpx;
  color: #86909c;
  background: #f2f3f5;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.trade-status.on {
  color: #07c160;
  background: #e8f8ef;
}

.trade-across {
  font-size: 22rpx;
  color: #4e5969;
}

.trade-garden {
  font-size: 20rpx;
  color: #a8abb2;
}

/* 定时信息 */
.schedule-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.schedule-item {
  flex: 1;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.schedule-off {
  opacity: 0.55;
}

.schedule-label {
  font-size: 22rpx;
  color: #86909c;
}

.schedule-time {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2329;
  font-family: monospace;
}

.schedule-last {
  font-size: 20rpx;
  color: #a8abb2;
}

/* ===== 托管花园范围 ===== */
.garden-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 20rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
}

.garden-label {
  font-size: 24rpx;
  color: #86909c;
}

.garden-value {
  flex: 1;
  font-size: 26rpx;
  color: #1f2329;
  font-weight: 500;
}

.garden-toggle {
  font-size: 22rpx;
  color: #1677ff;
}

/* 花园选择面板 */
.garden-picker {
  margin-top: 16rpx;
  background: #fafbfc;
  border: 1rpx solid #eef0f3;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.garden-picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.mode-group {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.mode-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #4e5969;
}

.reload-gardens {
  font-size: 22rpx;
  color: #1677ff;
  padding: 6rpx 12rpx;
}

.garden-list {
  display: flex;
  flex-direction: column;
}

.garden-check {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f1f3;
}

.garden-check:last-child {
  border-bottom: none;
}

.checkbox {
  width: 34rpx;
  height: 34rpx;
  border-radius: 8rpx;
  border: 2rpx solid #c9cdd4;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.checkbox-on {
  background: #07c160;
  border-color: #07c160;
}

.checkbox-dim {
  opacity: 0.5;
}

.checkbox-mark {
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.garden-check-name {
  flex: 1;
  font-size: 26rpx;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.garden-channel {
  font-size: 20rpx;
  color: #86909c;
  background: #f2f3f5;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

/* 花园卡片右上角：实时托管状态徽标 */
.garden-state-badge {
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  flex-shrink: 0;
}

.garden-state-badge.on {
  color: #07c160;
  background: #e8f8ef;
  font-weight: 500;
}

.garden-state-badge.off {
  color: #86909c;
  background: #f2f3f5;
}

.act-log {
  background: #eef6ff;
  color: #1677ff;
}

/* ===== 正在托管面板 ===== */
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  margin: 28rpx 4rpx 16rpx;
}

.host-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(31, 35, 41, 0.04);
}

.host-line1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.host-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  max-width: 460rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.host-state {
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  flex-shrink: 0;
}

.host-state.active {
  color: #07c160;
  background: #e8f8ef;
}

.host-state.idle {
  color: #86909c;
  background: #f2f3f5;
}

.host-line2 {
  font-size: 24rpx;
  color: #86909c;
  margin-top: 8rpx;
}

.host-actions {
  margin-top: 18rpx;
  display: flex;
  gap: 12rpx;
}

/* ===== 账号面板卡片 ===== */
.panel-card {
  width: 100%;
  box-sizing: border-box;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.panel-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.panel-badge {
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  flex-shrink: 0;
}

.panel-badge.on {
  color: #07c160;
  background: #e8f8ef;
}

.panel-badge.off {
  color: #86909c;
  background: #f2f3f5;
}

.panel-summary {
  font-size: 22rpx;
  color: #86909c;
  margin-top: 8rpx;
}

.panel-gardens {
  margin-top: 12rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 4rpx 20rpx;
}

.garden-state-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.garden-pause {
  font-size: 20rpx;
  padding: 0 14rpx;
  line-height: 1.8;
}

.panel-logs {
  width: 100%;
  height: 360rpx;
  margin-top: 12rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 6rpx 20rpx;
  box-sizing: border-box;
}

.panel-more {
  text-align: center;
  font-size: 22rpx;
  color: #a8abb2;
  padding: 12rpx 0;
}

/* ===== 花园动态日志弹层 ===== */
.log-scroll {
  max-height: 55vh;
  min-height: 240rpx;
}

.sheet-auto {
  text-align: center;
  font-size: 22rpx;
  color: #07c160;
  margin-bottom: 8rpx;
}

.sheet-auto.refreshing {
  color: #a8abb2;
}

.garden-empty {
  font-size: 22rpx;
  color: #a8abb2;
  padding: 16rpx 0;
  text-align: center;
}

.act-save-gardens {
  margin-top: 16rpx;
  background: #eef6ff;
  color: #1677ff;
}

/* ===== 托管状态 ===== */
.hosting-line {
  margin-top: 16rpx;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  flex-wrap: wrap;
}

.hosting-text {
  font-size: 22rpx;
  color: #4e5969;
}

.hosting-time {
  font-size: 20rpx;
  color: #a8abb2;
}

.status-box {
  margin-top: 16rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.status-summary {
  font-size: 24rpx;
  color: #4e5969;
  margin-bottom: 10rpx;
}

.status-loading {
  font-size: 24rpx;
  color: #86909c;
}

.status-garden {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
  border-top: 1rpx solid #f0f1f3;
}

.garden-name {
  font-size: 24rpx;
  color: #1f2329;
  max-width: 480rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.garden-state {
  font-size: 22rpx;
  color: #07c160;
}

.act-btn {
  margin: 0;
  font-size: 24rpx;
  padding: 0 18rpx;
  line-height: 2.1;
  border-radius: 10rpx;
  background: #f2f3f5;
  color: #4e5969;
}

.act-btn::after {
  border: none;
}

.act-start {
  background: #e8f8ef;
  color: #07c160;
}

.act-pause {
  background: #fdeceb;
  color: #fa5151;
}

.act-status {
  background: #eef6ff;
  color: #1677ff;
}

/* ===== 空状态 ===== */
.empty {
  text-align: center;
  color: #86909c;
  font-size: 26rpx;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-sub {
  font-size: 22rpx;
  color: #a8abb2;
  margin-top: 8rpx;
}

/* ===== 日志 ===== */
.logs-section {
  margin-top: 32rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.logs-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  margin-bottom: 16rpx;
}

.logs-loading {
  font-size: 24rpx;
  color: #86909c;
}

.log-item {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f1f3;
}

.log-item:last-child {
  border-bottom: none;
}

.log-line1 {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.log-time {
  font-size: 22rpx;
  color: #86909c;
  font-family: monospace;
}

.log-tag {
  font-size: 20rpx;
  color: #4e5969;
  background: #f2f3f5;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.log-action {
  font-size: 22rpx;
  color: #4e5969;
}

.log-result {
  font-size: 20rpx;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.log-result.ok {
  color: #07c160;
  background: #e8f8ef;
}

.log-result.fail {
  color: #fa5151;
  background: #fdeceb;
}

.log-line2 {
  font-size: 22rpx;
  color: #86909c;
  margin-top: 6rpx;
  line-height: 1.5;
}

.log-fail .log-line2 {
  color: #b47a7a;
}

/* ===== 表单弹层 ===== */
.form-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.form-panel {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.form-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
  text-align: center;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 22rpx;
}

.form-item.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: #4e5969;
  margin-bottom: 10rpx;
}

.form-item.row .form-label {
  margin-bottom: 0;
}

.form-input {
  background: #f7f8fa;
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: #1f2329;
}

.form-switch-block {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.time-picker {
  background: #f7f8fa;
  border-radius: 10rpx;
  padding: 14rpx 24rpx;
  font-size: 28rpx;
  color: #1f2329;
  font-family: monospace;
  min-width: 140rpx;
  text-align: center;
}

.time-picker-off {
  color: #a8abb2;
}

.form-hint {
  font-size: 22rpx;
  color: #a8abb2;
  max-width: 380rpx;
  text-align: right;
}

.form-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.form-btn {
  flex: 1;
  font-size: 28rpx;
  border-radius: 12rpx;
  line-height: 2.6;
}

.form-btn::after {
  border: none;
}

.form-btn.cancel {
  background: #f2f3f5;
  color: #4e5969;
}

.form-btn.save {
  background: #07c160;
  color: #fff;
}

/* ===== 时段编辑器 ===== */
.form-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.form-label-action {
  font-size: 24rpx;
  color: #1677ff;
  padding: 4rpx 8rpx;
}

.form-label-action.action-disabled {
  color: #a8abb2;
}

.window-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #f7f8fa;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 12rpx;
}

.window-index {
  font-size: 24rpx;
  color: #86909c;
  width: 84rpx;
  flex-shrink: 0;
}

.minute-input {
  background: #fff;
  border: 1rpx solid #e5e6eb;
  border-radius: 8rpx;
  padding: 10rpx 12rpx;
  font-size: 28rpx;
  color: #1f2329;
  font-family: monospace;
  width: 96rpx;
  text-align: center;
  box-sizing: border-box;
}

.window-sep {
  font-size: 24rpx;
  color: #86909c;
}

.window-remove {
  margin-left: auto;
  font-size: 30rpx;
  color: #fa5151;
  padding: 6rpx 12rpx;
}

.window-add {
  text-align: center;
  font-size: 26rpx;
  color: #1677ff;
  background: #f2f7ff;
  border: 1rpx dashed #b8d4ff;
  border-radius: 10rpx;
  padding: 16rpx 0;
  margin-bottom: 12rpx;
}

/* ===== 专属时段（如 21~22 点单独设置） ===== */
.editor-sub-tip {
  font-size: 22rpx;
  color: #fa8c16;
  margin: 18rpx 0 10rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #ffd591;
}

.editor-sub-tip:first-of-type {
  border-top: none;
}

.window-index.special {
  color: #fa8c16;
}

.window-add.special {
  color: #fa8c16;
  background: #fff7e6;
  border-color: #ffd591;
}

.form-hint.block {
  display: block;
  text-align: left;
  max-width: none;
  margin-top: 4rpx;
  line-height: 1.5;
}

.schedule-empty {
  color: #a8abb2;
  font-weight: 400;
}

/* ===== 常显花园选择 / 状态 ===== */
.garden-title,
.status-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #4e5969;
}

.garden-picker-head-right,
.status-head-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.status-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.status-updated {
  font-size: 20rpx;
  color: #a8abb2;
}

.status-refresh {
  font-size: 22rpx;
  color: #1677ff;
  padding: 4rpx 10rpx;
}

.status-empty {
  font-size: 22rpx;
  color: #a8abb2;
  padding: 8rpx 0;
}

/* ===== 花园行（每花园独立：开关 / 时段 / 启停） ===== */
.garden-item {
  border-bottom: 1rpx solid #eef0f3;
  padding: 16rpx 0;
}

.garden-item:last-child {
  border-bottom: none;
}

/* 正在托管中的花园：凸起高亮 */
.garden-item.hosting {
  background: linear-gradient(135deg, #eefaf3, #ffffff);
  border: 2rpx solid #07c160;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin: 8rpx -12rpx;
  transform: scale(1.03);
  box-shadow: 0 10rpx 26rpx rgba(7, 193, 96, 0.35), 0 3rpx 10rpx rgba(7, 193, 96, 0.2);
}

.garden-row-line {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.garden-sched-switch {
  flex-shrink: 0;
  transform: scale(0.8);
}

.garden-info {
  flex: 1;
  min-width: 0;
}

.garden-row-name {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.garden-row-windows {
  font-size: 22rpx;
  color: #4e5969;
  margin-top: 4rpx;
  font-family: monospace;
}

.garden-row-windows.special {
  color: #73593d;
  margin-top: 2rpx;
}

.win-empty {
  color: #a8abb2;
  font-family: inherit;
}

.garden-row-actions {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.garden-row-actions .act-btn {
  font-size: 26rpx;
  padding: 0 44rpx;
  line-height: 2.4;
}

.garden-row-actions .act-btn[disabled] {
  color: #a8abb2;
  background: #f2f3f5;
}

.garden-win-editor {
  margin-top: 12rpx;
  background: #f7f8fa;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
}

.editor-tip {
  font-size: 22rpx;
  color: #4e5969;
  margin-bottom: 10rpx;
}

.editor-actions {
  display: flex;
  gap: 14rpx;
  justify-content: flex-end;
}

/* ===== 花园行内动态日志 ===== */
.garden-inline-logs {
  margin-top: 8rpx;
  background: #f7f8fa;
  border: 1rpx solid #eef0f3;
  border-radius: 10rpx;
  padding: 6rpx 14rpx;
}

.inline-logs-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 2rpx 0;
}

.inline-logs-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #4e5969;
}

.inline-logs-hint {
  font-size: 20rpx;
  color: #07c160;
  background: #e8f8ef;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.inline-logs-toggle {
  margin-left: auto;
  font-size: 22rpx;
  color: #1677ff;
  padding: 4rpx 8rpx;
}

.inline-logs-error {
  font-size: 22rpx;
  color: #fa5151;
  padding: 6rpx 0;
}

/* 日志滚动区：固定较小高度，超出可上下滚动 */
.inline-logs-scroll {
  max-height: 250rpx;
  width: 100%;
}

.garden-inline-logs .log-item {
  padding: 8rpx 0;
  border-bottom: 1rpx solid #eef0f3;
}

.garden-inline-logs .log-item:last-child {
  border-bottom: none;
}

.garden-inline-logs .log-time {
  font-size: 20rpx;
}

.garden-inline-logs .log-line2 {
  font-size: 22rpx;
  margin-top: 2rpx;
  line-height: 1.4;
}

.reload-gardens.assign {
  color: #07c160;
  font-weight: 500;
}

.action-disabled {
  color: #a8abb2;
}
