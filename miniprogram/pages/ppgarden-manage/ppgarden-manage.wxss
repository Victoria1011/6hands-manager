/* ppgarden-manage.wxss */
.container {
  min-height: 100vh;
  background: #f4f5f7;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* ===== 头部 ===== */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2329;
}

.header-actions {
  display: flex;
  gap: 12rpx;
}

.header-actions.sub {
  margin-bottom: 16rpx;
  justify-content: flex-start;
}

.master-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
}

.master-label {
  font-size: 26rpx;
  color: #1f2329;
  font-weight: 500;
}

.mini-btn {
  margin: 0;
  font-size: 24rpx;
  line-height: 2.2;
  border-radius: 10rpx;
  padding: 0 20rpx;
}

.mini-btn.primary {
  background: #07c160;
  color: #fff;
}

.mini-btn.ghost {
  background: #fff;
  color: #4e5969;
  border: 1rpx solid #dcdfe4;
}

.mini-btn.site {
  background: #1677ff;
  color: #fff;
}

/* ===== 提示条 ===== */
.tip-bar {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  background: #eef6ff;
  border: 1rpx solid #d6e8ff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
}

.tip-icon {
  font-size: 26rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #4e6b8a;
  line-height: 1.6;
}

/* ===== 账号卡片 ===== */
.account-list {
  display: flex;
  flex-direction: column;
  width: 100%;
}

.account-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(31, 35, 41, 0.04);
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.account-name {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.name-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-badge {
  font-size: 20rpx;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.session-badge.ok {
  color: #07c160;
  background: #e8f8ef;
}

.session-badge.bad {
  color: #fa5151;
  background: #fdeceb;
}

.session-badge.idle {
  color: #86909c;
  background: #f2f3f5;
}

.disabled-badge {
  font-size: 20rpx;
  color: #fa8c16;
  background: #fff7e6;
  border: 1rpx solid #ffd591;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.switch-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.switch-label {
  font-size: 22rpx;
  color: #86909c;
}

.account-sub {
  font-size: 24rpx;
  color: #86909c;
  margin-top: 6rpx;
}

/* 定时信息 */
.schedule-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.schedule-item {
  flex: 1;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.schedule-off {
  opacity: 0.55;
}

.schedule-label {
  font-size: 22rpx;
  color: #86909c;
}

.schedule-time {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2329;
  font-family: monospace;
}

.schedule-last {
  font-size: 20rpx;
  color: #a8abb2;
}

/* ===== 托管花园范围 ===== */
.garden-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 20rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
}

.garden-label {
  font-size: 24rpx;
  color: #86909c;
}

.garden-value {
  flex: 1;
  font-size: 26rpx;
  color: #1f2329;
  font-weight: 500;
}

.garden-toggle {
  font-size: 22rpx;
  color: #1677ff;
}

/* 花园选择面板 */
.garden-picker {
  margin-top: 16rpx;
  background: #fafbfc;
  border: 1rpx solid #eef0f3;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.garden-picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.mode-group {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.mode-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #4e5969;
}

.reload-gardens {
  font-size: 22rpx;
  color: #1677ff;
  padding: 6rpx 12rpx;
}

.garden-list {
  display: flex;
  flex-direction: column;
}

.garden-check {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f1f3;
}

.garden-check:last-child {
  border-bottom: none;
}

.checkbox {
  width: 34rpx;
  height: 34rpx;
  border-radius: 8rpx;
  border: 2rpx solid #c9cdd4;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.checkbox-on {
  background: #07c160;
  border-color: #07c160;
}

.checkbox-dim {
  opacity: 0.5;
}

.checkbox-mark {
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.garden-check-name {
  flex: 1;
  font-size: 26rpx;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.garden-channel {
  font-size: 20rpx;
  color: #86909c;
  background: #f2f3f5;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.garden-empty {
  font-size: 22rpx;
  color: #a8abb2;
  padding: 16rpx 0;
  text-align: center;
}

.act-save-gardens {
  margin-top: 16rpx;
  background: #eef6ff;
  color: #1677ff;
}

/* ===== 托管状态 ===== */
.hosting-line {
  margin-top: 16rpx;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  flex-wrap: wrap;
}

.hosting-text {
  font-size: 22rpx;
  color: #4e5969;
}

.hosting-time {
  font-size: 20rpx;
  color: #a8abb2;
}

.status-box {
  margin-top: 16rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.status-summary {
  font-size: 24rpx;
  color: #4e5969;
  margin-bottom: 10rpx;
}

.status-loading {
  font-size: 24rpx;
  color: #86909c;
}

.status-garden {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
  border-top: 1rpx solid #f0f1f3;
}

.garden-name {
  font-size: 24rpx;
  color: #1f2329;
  max-width: 480rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.garden-state {
  font-size: 22rpx;
  color: #07c160;
}

/* 操作按钮 */
.card-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.act-btn {
  margin: 0;
  font-size: 24rpx;
  padding: 0 18rpx;
  line-height: 2.1;
  border-radius: 10rpx;
  background: #f2f3f5;
  color: #4e5969;
}

.act-btn::after {
  border: none;
}

.act-start {
  background: #e8f8ef;
  color: #07c160;
}

.act-pause {
  background: #fdeceb;
  color: #fa5151;
}

.act-status {
  background: #eef6ff;
  color: #1677ff;
}

.act-danger {
  background: #f2f3f5;
  color: #fa5151;
}

/* ===== 空状态 ===== */
.empty {
  text-align: center;
  color: #86909c;
  font-size: 26rpx;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-sub {
  font-size: 22rpx;
  color: #a8abb2;
  margin-top: 8rpx;
}

/* ===== 日志 ===== */
.logs-section {
  margin-top: 32rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.logs-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  margin-bottom: 16rpx;
}

.logs-loading {
  font-size: 24rpx;
  color: #86909c;
}

.log-item {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f1f3;
}

.log-item:last-child {
  border-bottom: none;
}

.log-line1 {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.log-time {
  font-size: 22rpx;
  color: #86909c;
  font-family: monospace;
}

.log-tag {
  font-size: 20rpx;
  color: #4e5969;
  background: #f2f3f5;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.log-action {
  font-size: 22rpx;
  color: #4e5969;
}

.log-result {
  font-size: 20rpx;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.log-result.ok {
  color: #07c160;
  background: #e8f8ef;
}

.log-result.fail {
  color: #fa5151;
  background: #fdeceb;
}

.log-line2 {
  font-size: 22rpx;
  color: #86909c;
  margin-top: 6rpx;
  line-height: 1.5;
}

.log-fail .log-line2 {
  color: #b47a7a;
}

/* ===== 表单弹层 ===== */
.form-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.form-panel {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.form-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
  text-align: center;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 22rpx;
}

.form-item.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: #4e5969;
  margin-bottom: 10rpx;
}

.form-item.row .form-label {
  margin-bottom: 0;
}

.form-input {
  background: #f7f8fa;
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: #1f2329;
}

.form-switch-block {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.time-picker {
  background: #f7f8fa;
  border-radius: 10rpx;
  padding: 14rpx 24rpx;
  font-size: 28rpx;
  color: #1f2329;
  font-family: monospace;
  min-width: 140rpx;
  text-align: center;
}

.time-picker-off {
  color: #a8abb2;
}

.form-hint {
  font-size: 22rpx;
  color: #a8abb2;
  max-width: 380rpx;
  text-align: right;
}

.form-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.form-btn {
  flex: 1;
  font-size: 28rpx;
  border-radius: 12rpx;
  line-height: 2.6;
}

.form-btn::after {
  border: none;
}

.form-btn.cancel {
  background: #f2f3f5;
  color: #4e5969;
}

.form-btn.save {
  background: #07c160;
  color: #fff;
}

/* ===== 时段编辑器 ===== */
.form-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.form-label-action {
  font-size: 24rpx;
  color: #1677ff;
  padding: 4rpx 8rpx;
}

.form-label-action.action-disabled {
  color: #a8abb2;
}

.window-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #f7f8fa;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 12rpx;
}

.window-index {
  font-size: 24rpx;
  color: #86909c;
  width: 84rpx;
  flex-shrink: 0;
}

.minute-input {
  background: #fff;
  border: 1rpx solid #e5e6eb;
  border-radius: 8rpx;
  padding: 10rpx 12rpx;
  font-size: 28rpx;
  color: #1f2329;
  font-family: monospace;
  width: 96rpx;
  text-align: center;
  box-sizing: border-box;
}

.window-sep {
  font-size: 24rpx;
  color: #86909c;
}

.window-remove {
  margin-left: auto;
  font-size: 30rpx;
  color: #fa5151;
  padding: 6rpx 12rpx;
}

.window-add {
  text-align: center;
  font-size: 26rpx;
  color: #1677ff;
  background: #f2f7ff;
  border: 1rpx dashed #b8d4ff;
  border-radius: 10rpx;
  padding: 16rpx 0;
  margin-bottom: 12rpx;
}

.form-hint.block {
  display: block;
  text-align: left;
  max-width: none;
  margin-top: 4rpx;
  line-height: 1.5;
}

.schedule-empty {
  color: #a8abb2;
  font-weight: 400;
}

/* ===== 常显花园选择 / 状态 ===== */
.garden-title,
.status-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #4e5969;
}

.garden-picker-head-right,
.status-head-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.status-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.status-updated {
  font-size: 20rpx;
  color: #a8abb2;
}

.status-refresh {
  font-size: 22rpx;
  color: #1677ff;
  padding: 4rpx 10rpx;
}

.status-empty {
  font-size: 22rpx;
  color: #a8abb2;
  padding: 8rpx 0;
}

/* ===== 花园行（每花园独立：开关 / 时段 / 启停） ===== */
.garden-item {
  border-bottom: 1rpx solid #eef0f3;
  padding: 16rpx 0;
}

.garden-item:last-child {
  border-bottom: none;
}

.garden-row-line {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.garden-sched-switch {
  flex-shrink: 0;
  transform: scale(0.8);
}

.garden-info {
  flex: 1;
  min-width: 0;
}

.garden-row-name {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.garden-row-windows {
  font-size: 22rpx;
  color: #4e5969;
  margin-top: 4rpx;
  font-family: monospace;
}

.win-empty {
  color: #a8abb2;
  font-family: inherit;
}

.garden-row-actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex-shrink: 0;
}

.garden-row-actions .act-btn {
  font-size: 22rpx;
  padding: 0 14rpx;
  line-height: 1.9;
}

.garden-win-editor {
  margin-top: 12rpx;
  background: #f7f8fa;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
}

.editor-tip {
  font-size: 22rpx;
  color: #4e5969;
  margin-bottom: 10rpx;
}

.editor-actions {
  display: flex;
  gap: 14rpx;
  justify-content: flex-end;
}

.reload-gardens.assign {
  color: #07c160;
  font-weight: 500;
}

.action-disabled {
  color: #a8abb2;
}
