<view class="container">
  <!-- 头部 -->
  <view class="header">

    <view class="header-actions">
      <view class="voice-type-tabs">
        <view
          class="type-tab {{currentType === 'all' ? 'type-tab-active' : ''}}"
          bindtap="switchType"
          data-type="all"
        >
          全部 ({{kindCounts.clone + kindCounts.design}})
        </view>
        <view
          class="type-tab {{currentType === 'clone' ? 'type-tab-active' : ''}}"
          bindtap="switchType"
          data-type="clone"
        >
          克隆 ({{kindCounts.clone}})
        </view>
        <view
          class="type-tab {{currentType === 'design' ? 'type-tab-active' : ''}}"
          bindtap="switchType"
          data-type="design"
        >
          设计 ({{kindCounts.design}})
        </view>
      </view>
      <view class="header-buttons">
        <button class="batch-mode-btn {{batchMode ? 'batch-mode-active' : ''}}" bindtap="toggleBatchMode" wx:if="{{!loading && (currentListTab !== 'suggest' || batchMode)}}">
          {{batchMode ? '取消' : '选择'}}
        </button>
        <button class="refresh-btn" bindtap="onRefresh" loading="{{loading}}" wx:if="{{!batchMode}}">
          <text wx:if="{{!loading}}">刷新</text>
          <text wx:else>加载中...</text>
        </button>
      </view>
    </view>

    <!-- 音色 ID 搜索 -->
    <view class="search-bar">
      <input
        class="search-input"
        type="text"
        value="{{searchKeyword}}"
        placeholder="输入音色 ID 搜索"
        placeholder-class="search-placeholder"
        confirm-type="search"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
      />
      <view class="search-clear" wx:if="{{searchKeyword}}" bindtap="onClearSearch">✕</view>
      <button class="search-btn" size="mini" bindtap="onSearchConfirm">搜索</button>
    </view>

    <!-- 列表标签：全部 / 建议清理 -->
    <!-- 说明：Qwen 系列模型已下架，音色统一来自 CosyVoice，不再需要来源筛选 -->
    <view class="list-tab-bar" wx:if="{{!loading}}">
      <view
        class="list-tab {{currentListTab === 'all' ? 'list-tab-active' : ''}}"
        bindtap="switchListTab"
        data-tab="all"
      >
        全部
      </view>
      <view
        class="list-tab {{currentListTab === 'suggest' ? 'list-tab-active list-tab-suggest-active' : ''}}"
        bindtap="switchListTab"
        data-tab="suggest"
      >
        建议清理
        <text class="suggest-badge" wx:if="{{suggestDeleteCount > 0}}">{{suggestDeleteCount}}</text>
      </view>
      <view class="suggest-actions" wx:if="{{currentListTab === 'suggest' && suggestDeleteCount > 0 && !batchMode}}">
        <button class="suggest-select-btn" catchtap="toggleBatchMode" size="mini">
          选择删除
        </button>
        <button class="suggest-clean-btn" catchtap="onSuggestBatchDelete" size="mini">
          一键清理
        </button>
      </view>
    </view>

    <!-- 账号选项卡 -->
    <view class="account-tabs" wx:if="{{!loading}}">
      <view
        class="account-tab {{currentAccount === 'all' ? 'account-tab-active' : ''}}"
        bindtap="switchAccount"
        data-account="all"
      >
        全部 ({{currentListTab === 'suggest' ? suggestDeleteCount : totalCount}})
      </view>
      <view
        class="account-tab {{currentAccount === 'main' ? 'account-tab-active' : ''}}"
        bindtap="switchAccount"
        data-account="main"
      >
        {{accountNames.main}} ({{currentListTab === 'suggest' ? suggestDeleteStats.main : accountStats.main}})
      </view>
      <view
        class="account-tab {{currentAccount === 'v' ? 'account-tab-active' : ''}}"
        bindtap="switchAccount"
        data-account="v"
      >
        {{accountNames.v}} ({{currentListTab === 'suggest' ? suggestDeleteStats.v : accountStats.v}})
      </view>
      <view
        class="account-tab {{currentAccount === 'w' ? 'account-tab-active' : ''}}"
        bindtap="switchAccount"
        data-account="w"
      >
        {{accountNames.w}} ({{currentListTab === 'suggest' ? suggestDeleteStats.w : accountStats.w}})
      </view>
    </view>

    <!-- 批量操作工具栏 -->
    <view class="batch-toolbar" wx:if="{{batchMode}}">
      <view class="batch-select-all" bindtap="toggleSelectAll">
        <text class="select-all-text">{{selectedCount > 0 ? '取消选择' : '全选'}}</text>
      </view>
      <view class="batch-select-ten" bindtap="selectTen">
        <text class="select-ten-text">+10个</text>
      </view>
      <text class="batch-count">已选择: {{selectedCount}}</text>
      <button class="batch-delete-btn" bindtap="onBatchDelete" disabled="{{selectedCount === 0}}">
        删除 ({{selectedCount}})
      </button>
    </view>
  </view>

  <!-- 统计信息 -->
  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-value">{{displayCount}}</text>
      <text class="stat-label">{{currentListTab === 'suggest' ? '建议清理' : (currentType === 'clone' ? '克隆音色' : (currentType === 'design' ? '设计音色' : '音色'))}}总数</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{savedVoiceCount}}</text>
      <text class="stat-label">已保存数</text>
    </view>
  </view>

  <!-- 建议清理说明 -->
  <view class="suggest-hint" wx:if="{{currentListTab === 'suggest' && !loading}}">
    <text class="suggest-hint-text">以下音色未保存且最近120天未使用，建议清理</text>
  </view>

  <!-- 音色列表 -->
  <view class="voice-list" wx:if="{{voiceList.length > 0}}">
    <view class="voice-card {{item.user_info && item.user_info.type === 'saved' ? 'voice-card-saved' : ''}} {{batchMode ? 'voice-card-batch' : ''}}" wx:for="{{voiceList}}" wx:key="voice" data-voice="{{item.voice}}" bindtap="onSelectVoice" wx:if="{{!batchMode || (!item.in_speakers && (!item.user_info || item.user_info.type !== 'saved'))}}">
      <view class="voice-header">
        <view class="voice-info">
          <!-- 批量模式复选框 -->
          <view class="voice-checkbox" wx:if="{{batchMode && !item.in_speakers && (!item.user_info || item.user_info.type !== 'saved')}}">
            <view class="checkbox {{selectedVoices[item.voice] ? 'checkbox-checked' : ''}}">
              <text class="check-icon" wx:if="{{selectedVoices[item.voice]}}">✓</text>
            </view>
          </view>
          <view class="voice-content">
            <text class="voice-name">{{item.voice}}</text>
            <view class="voice-model-row">
              <text class="voice-model">模型: {{item.target_model || '-'}}</text>
              <text class="voice-speakers-badge voice-speakers-system" wx:if="{{item.in_speakers === 'system'}}">已入正式音色库</text>
              <text class="voice-speakers-badge voice-speakers-test" wx:elif="{{item.in_speakers === 'test'}}">已在测试音色库</text>
            </view>
          </view>
        </view>
        <view class="voice-actions" wx:if="{{!batchMode}}">
          <button class="copy-btn" size="mini" bindtap="onCopyVoice" data-voice="{{item.voice}}">
            复制
          </button>
          <button class="delete-btn" size="mini" bindtap="onDeleteVoice" data-voice="{{item.voice}}" data-creator-openid="{{item.user_info ? item.user_info.openid : ''}}" data-account-type="{{item.account_type}}" data-provider="{{item.provider}}" wx:if="{{!item.in_speakers && (!item.user_info || item.user_info.type !== 'saved')}}">
            删除
          </button>
          <text class="delete-locked-tag" wx:elif="{{item.in_speakers}}">
            {{item.in_speakers === 'system' ? '已入正式音色库·不可删除' : '已在测试音色库·不可删除'}}
          </text>
        </view>
      </view>
      <view class="voice-footer">
        <text class="voice-time">创建时间: {{item.gmt_create}}</text>
        <view class="voice-account-badge">
          <text class="account-badge-text">{{accountNames[item.account_type] || item.account_type}}</text>
        </view>
      </view>
      <view class="voice-footer voice-last-used" wx:if="{{item.last_used_time}}">
        <text class="voice-time">最近使用: {{item.last_used_time}}</text>
      </view>

      <!-- 声音设计建议清理：播放预览 + 上传到测试音色库 -->
      <view class="voice-design-actions" wx:if="{{!batchMode && currentListTab === 'suggest' && item.voice_kind === 'design' && item.creation_log}}">
        <view class="design-action-row" wx:if="{{item.creation_log.preview_audio_file_id}}">
          <text class="design-action-label">音频:</text>
          <text class="design-play-link" catchtap="onPlayAudio" data-audio-id="{{item.creation_log.preview_audio_file_id}}">
            {{currentPlayingAudioId === item.creation_log.preview_audio_file_id ? '⏸ 停止播放' : '▶ 播放并复制链接'}}
          </text>
        </view>
        <view class="design-action-row">
          <text class="design-action-label"></text>
          <text class="design-uploaded-tag" wx:if="{{item.isUploaded || item.in_speakers === 'test' || item.in_speakers === 'system'}}">✓ 已上传</text>
          <text
            class="design-upload-link"
            wx:else
            catchtap="onUploadVoice"
            data-voice-id="{{item.voice}}"
            data-voice-name="{{item.creation_log.voice_name}}"
            data-voice-prompt="{{item.creation_log.voice_prompt}}"
            data-used-api-key="{{item.creation_log.used_api_key}}"
            data-preview-text="{{item.creation_log.preview_text}}"
            data-preview-audio-file-id="{{item.creation_log.preview_audio_file_id}}"
            data-language="{{item.creation_log.language}}"
            data-target-model="{{item.creation_log.target_model}}"
            data-type="{{item.creation_log.creation_type || 'design'}}">⬆ 上传到测试音色库</text>
        </view>
      </view>

      <view class="voice-users" wx:if="{{item.user_info && !batchMode}}">
        <view class="user-info-row">
          <text class="user-label">{{item.user_info.type === 'saved' ? '保存者' : '创建者'}} OpenID:</text>
          <view class="user-value user-value-clickable" bindtap="onTapOpenid" data-openid="{{item.user_info.openid}}">
            <text>{{item.user_info.openid}}</text>
            <text class="copy-icon">🔗</text>
          </view>
        </view>
        <view class="user-info-row">
          <text class="user-label">音色名称:</text>
          <text class="user-value">{{item.user_info.voice_name}}</text>
        </view>
        <view class="user-type-badge" wx:if="{{item.user_info.type === 'saved'}}">
          <text class="badge-text">已保存</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 列表底部加载提示 -->
  <view class="load-more" wx:if="{{voiceList.length > 0}}">
    <text wx:if="{{searching}}">点击「搜索」在全部账号中查找该音色</text>
    <text wx:elif="{{hasMore}}">上拉加载更多 · 已显示 {{voiceList.length}}/{{displayCount}}</text>
    <text wx:else>已全部加载 · 共 {{displayCount}} 个</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && voiceList.length === 0}}">
    <view class="empty-icon">🎙️</view>
    <block wx:if="{{searching}}">
      <text class="empty-text">未找到音色</text>
      <text class="empty-tip">未找到 ID 为 {{searchKeyword}} 的音色{{searchScannedLoaded ? '，请点击「搜索」在全部账号中查找' : ''}}</text>
    </block>
    <block wx:else>
      <text class="empty-text">{{currentListTab === 'suggest' ? '无需清理' : '暂无音色'}}</text>
      <text class="empty-tip">{{currentListTab === 'suggest' ? '没有未保存且最近120天未使用的音色' : '您还没有创建任何音色'}}</text>
    </block>
  </view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading && voiceList.length === 0}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 批量删除进度弹窗 -->
  <view class="dp-mask" wx:if="{{deleteProgress.visible}}" catchtouchmove="onPreventTouchMove">
    <view class="dp-panel">
      <view class="dp-header">
        <text class="dp-title">批量删除音色</text>
        <text class="dp-summary">进度 {{deleteProgress.finished}}/{{deleteProgress.total}} · 成功 {{deleteProgress.successCount}} · 失败 {{deleteProgress.failCount}}</text>
      </view>
      <view class="dp-bar">
        <view class="dp-bar-inner {{deleteProgress.failCount > 0 ? 'dp-bar-hasfail' : ''}}" style="width: {{deleteProgress.percent}}%"></view>
      </view>
      <view class="dp-current" wx:if="{{deleteProgress.running}}">
        <text class="dp-current-label">正在删除：</text>
        <text class="dp-current-name">{{deleteProgress.current}}</text>
      </view>
      <scroll-view class="dp-list" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="dp-item" wx:for="{{deleteProgress.items}}" wx:key="voice">
          <text class="dp-item-index">{{index + 1}}.</text>
          <text class="dp-item-name">{{item.voice}}</text>
          <text class="dp-item-status dp-status-{{item.status}}">{{item.statusText}}</text>
        </view>
      </scroll-view>
      <view class="dp-footer">
        <text class="dp-tip" wx:if="{{deleteProgress.running}}">删除中，请勿离开本页面...</text>
        <button class="dp-close-btn" wx:else bindtap="onCloseDeleteProgress">关闭</button>
      </view>
    </view>
  </view>
</view>
