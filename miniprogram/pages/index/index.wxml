<view class="container">
  <!-- 主内容区域 -->
  <view class="main-content">
    <!-- 标题 -->
    <view class="page-title">
      <text class="title-text">管理后台</text>
    </view>

    <!-- 用户查询 -->
    <view class="query-section">
      <view class="section-header">
        <text class="section-title">用户查询</text>
      </view>
      <view class="query-form">
        <view class="input-wrapper">
          <input
            class="query-input"
            placeholder="请输入用户 openid"
            value="{{openidInput}}"
            bindinput="onOpenidInput"
          />
        </view>
        <button class="query-btn" bindtap="onUserQuery">
          查询用户
        </button>
      </view>
    </view>

    <!-- 功能菜单 -->
    <view class="menu-section">
      <!-- 第一行：客服消息 - 独占整行 -->
      <view class="menu-row single">
        <view class="menu-item full-width" bindtap="onCustomerService">
          <view class="menu-icon">💬</view>
          <text class="menu-text">客服消息</text>
        </view>
      </view>

      <!-- 第二行：音色管理 + 数据统计 -->
      <view class="menu-row">
        <view class="menu-item" bindtap="onVoiceManage">
          <view class="menu-icon">🎙️</view>
          <text class="menu-text">音色管理</text>
        </view>
        <view class="menu-item" bindtap="onDatabase">
          <view class="menu-icon">🗄️</view>
          <text class="menu-text">数据统计</text>
        </view>
      </view>

      <!-- 第三行：退款处理 + 发票开具 -->
      <view class="menu-row">
        <view class="menu-item" bindtap="onRefund">
          <view class="menu-icon">💰</view>
          <text class="menu-text">退款处理</text>
        </view>
        <view class="menu-item" bindtap="onInvoice">
          <view class="menu-icon">📄</view>
          <text class="menu-text">发票开具</text>
        </view>
      </view>
    </view>
  </view>
</view>