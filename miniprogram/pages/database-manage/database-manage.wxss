/* 时间筛选 */
.time-filter-container {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.time-filter-header {
  margin-bottom: 20rpx;
}

.time-filter-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.time-filter-tabs {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.time-tab {
  padding: 16rpx 24rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s;
  border: 2rpx solid transparent;
}

.time-tab.active {
  background: #e3f2fd;
  color: #1890ff;
  border-color: #1890ff;
}

.time-tab:active {
  opacity: 0.7;
}

.custom-date-picker {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 20rpx;
}

.date-picker-btn {
  flex: 1;
  padding: 20rpx 30rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  border: 2rpx solid #e8e8e8;
  text-align: center;
}

.date-picker-btn text {
  font-size: 28rpx;
  color: #333;
}

.date-separator {
  font-size: 28rpx;
  color: #999;
}

.time-filter-tip {
  margin-top: 16rpx;
  padding: 12rpx 20rpx;
  background: #f0f9ff;
  border-radius: 6rpx;
  border-left: 4rpx solid #1890ff;
}

.time-filter-tip text {
  font-size: 24rpx;
  color: #666;
}

/* 统计信息区域 */
.stats-container {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.stats-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.stats-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.stats-period {
  font-size: 24rpx;
  color: #999;
}

.stats-grid {
  display: flex;
  gap: 20rpx;
}

.stat-card {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  border: 2rpx solid;
}

.stat-icon {
  font-size: 48rpx;
  flex-shrink: 0;
}

.stat-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  white-space: nowrap;
}

.clone-card {
  background: linear-gradient(135deg, #fff5f5 0%, #fff 100%);
  border-color: #ffcdd2;
}

.design-card {
  background: linear-gradient(135deg, #f3e5f5 0%, #fff 100%);
  border-color: #e1bee7;
}

.mimo-card {
  background: linear-gradient(135deg, #e8f5e9 0%, #fff 100%);
  border-color: #c8e6c9;
}

.qwen-card {
  background: linear-gradient(135deg, #fff3e0 0%, #fff 100%);
  border-color: #ffe0b2;
}

.users-card {
  background: linear-gradient(135deg, #e3f2fd 0%, #fff 100%);
  border-color: #bbdefb;
}

.sign-card {
  background: linear-gradient(135deg, #e8f5e9 0%, #fff 100%);
  border-color: #c8e6c9;
}

.ad-card {
  background: linear-gradient(135deg, #fff3e0 0%, #fff 100%);
  border-color: #ffe0b2;
}

.order-card {
  background: linear-gradient(135deg, #fce4ec 0%, #fff 100%);
  border-color: #f8bbd9;
}

.stats-grid-2 {
  margin-top: 20rpx;
}

.stats-grid-3 {
  display: flex;
  gap: 16rpx;
}

.stats-grid-3 .stat-card {
  flex: 1;
  padding: 20rpx;
}

.stats-grid-1 {
  margin-top: 0;
}

.stats-grid-1 .stat-card {
  max-width: 300rpx;
  margin: 0 auto;
}

/* 扁平化日志列表样式 */
.log-flat-item {
  background: linear-gradient(135deg, #f8f9fa 0%, #fff 100%);
  border-color: #e9ecef;
  margin-bottom: 20rpx;
}

.log-flat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #e9ecef;
}

.log-flat-openid {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.log-flat-label {
  font-size: 24rpx;
  color: #666;
  flex-shrink: 0;
}

.log-flat-value {
  font-size: 24rpx;
  color: #333;
  word-break: break-all;
}

.log-flat-type {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.log-type-clone {
  background: #ffebee;
  color: #e53935;
}

.log-type-design {
  background: #f3e5f5;
  color: #8e24aa;
}

.log-type-synthesize_mimo {
  background: #e8f5e9;
  color: #43a047;
}

.log-type-synthesize {
  background: #fff3e0;
  color: #fb8c00;
}

.log-flat-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.log-flat-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.log-flat-row .log-flat-label {
  min-width: 80rpx;
}

.log-flat-row .text-value {
  flex: 1;
  word-break: break-all;
  color: #666;
  font-size: 24rpx;
  line-height: 1.4;
  background: #f8f9fa;
  padding: 8rpx 12rpx;
  border-radius: 6rpx;
}

.log-flat-row .cost-value {
  color: #e53935;
  font-weight: 600;
}

.log-flat-row .audio-id-value {
  color: #1890ff;
  font-family: monospace;
  font-size: 22rpx;
}

.log-flat-row .audio-id-value:active {
  background: #e3f2fd;
}

/* Logs 类型筛选 tabs */
.log-filter-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.log-filter-tab {
  padding: 12rpx 28rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s;
  border: 2rpx solid transparent;
}

.log-filter-tab:active {
  transform: scale(0.95);
  opacity: 0.8;
}

.log-filter-tab.active {
  background: #e3f2fd;
  color: #1890ff;
  border-color: #1890ff;
  font-weight: 600;
}

/* Coins 类型筛选 tabs */
.coin-filter-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.coin-filter-tab {
  padding: 12rpx 28rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s;
  border: 2rpx solid transparent;
}

.coin-filter-tab:active {
