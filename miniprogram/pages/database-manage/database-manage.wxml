<view class="container">
  <!-- 集合选择 -->
  <view class="collection-section">
    <view class="section-title">选择数据表</view>
    
    <!-- 常用快捷标签 -->
    <view class="quick-tags">
      <view 
        class="quick-tag {{currentCollection === 'tts_clone_design_logs' ? 'active' : ''}}" 
        bindtap="onQuickSelect" 
        data-collection="tts_clone_design_logs">
        <text class="tag-icon">📋</text>
        <text class="tag-text">logs</text>
      </view>
      <view 
        class="quick-tag {{currentCollection === 'users' ? 'active' : ''}}" 
        bindtap="onQuickSelect" 
        data-collection="users">
        <text class="tag-icon">👥</text>
        <text class="tag-text">users</text>
      </view>
      <view 
        class="quick-tag {{currentCollection === 'coin_transactions' ? 'active' : ''}}" 
        bindtap="onQuickSelect" 
        data-collection="coin_transactions">
        <text class="tag-icon">💰</text>
        <text class="tag-text">coins</text>
      </view>
    </view>
    
    <picker mode="selector" range="{{collections}}" bindchange="onCollectionSelect">
      <view class="picker-container">
        <text class="picker-text {{currentCollection ? '' : 'picker-placeholder'}}">{{currentCollection || '请选择数据表'}}</text>
        <text class="picker-arrow">▼</text>
      </view>
    </picker>
  </view>

  <!-- 搜索 -->
  <view class="search-section" wx:if="{{currentCollection}}">
    <view class="search-row">
      <view class="search-field-wrapper">
        <input
          class="search-input"
          placeholder="字段名"
          value="{{searchField}}"
          bindinput="onSearchFieldInput"
        />
      </view>
      <view class="search-value-wrapper">
        <input
          class="search-input"
          placeholder="字段值"
          value="{{searchValue}}"
          bindinput="onSearchValueInput"
        />
      </view>
      <button class="search-btn" bindtap="onSearch" size="mini">搜索</button>
    </view>
  </view>

  <!-- tts_clone_design_logs 时间选择和统计 -->
  <view class="tts-stats-section" wx:if="{{currentCollection === 'tts_clone_design_logs'}}">
    <!-- 时间选择 -->
    <view class="time-filter-container">
      <view class="time-filter-header">
        <text class="time-filter-title">时间筛选</text>
      </view>
      <view class="time-filter-tabs">
        <view 
          class="time-tab {{timeFilterType === 'today' ? 'active' : ''}}" 
          bindtap="onTimeFilterChange" 
          data-type="today">
          当天
        </view>
        <view 
          class="time-tab {{timeFilterType === 'yesterday' ? 'active' : ''}}" 
          bindtap="onTimeFilterChange" 
          data-type="yesterday">
          昨天
        </view>
        <view 
          class="time-tab {{timeFilterType === 'last7days' ? 'active' : ''}}" 
          bindtap="onTimeFilterChange" 
          data-type="last7days">
          近7天
        </view>
        <view 
          class="time-tab {{timeFilterType === 'last30days' ? 'active' : ''}}" 
          bindtap="onTimeFilterChange" 
          data-type="last30days">
          近30天
        </view>
        <view 
          class="time-tab {{timeFilterType === 'custom' ? 'active' : ''}}" 
          bindtap="onTimeFilterChange" 
          data-type="custom">
          自定义
        </view>
      </view>
      <!-- 自定义日期选择 -->
      <view class="custom-date-picker" wx:if="{{timeFilterType === 'custom'}}">
        <picker mode="date" value="{{customStartDate}}" bindchange="onStartDateChange">
          <view class="date-picker-btn">
            <text>{{customStartDate || '开始日期'}}</text>
          </view>
        </picker>
        <text class="date-separator">至</text>
        <picker mode="date" value="{{customEndDate}}" bindchange="onEndDateChange">
          <view class="date-picker-btn">
            <text>{{customEndDate || '结束日期'}}</text>
          </view>
        </picker>
      </view>
      <view class="time-filter-tip" wx:if="{{currentCollection === 'tts_clone_design_logs'}}">
        <text>筛选时间范围内的操作统计</text>
      </view>
    </view>

    <!-- 统计信息 -->
    <view class="stats-container">
      <view class="stats-header">
        <text class="stats-title">统计信息</text>
        <text class="stats-period">{{statsPeriodText}}</text>
      </view>
      <view class="stats-grid stats-grid-2">
        <view class="stat-card clone-card">
          <view class="stat-icon">🎙️</view>
          <view class="stat-info">
            <text class="stat-value">{{stats.cloneCount}}</text>
            <text class="stat-label">克隆次数</text>
          </view>
        </view>
        <view class="stat-card design-card">
          <view class="stat-icon">🎨</view>
          <view class="stat-info">
            <text class="stat-value">{{stats.designCount}}</text>
            <text class="stat-label">声音设计次数</text>
          </view>
        </view>
      </view>
      <view class="stats-grid stats-grid-2">
        <view class="stat-card mimo-card">
          <view class="stat-icon">🦊</view>
          <view class="stat-info">
            <text class="stat-value">{{stats.mimoChars}}</text>
            <text class="stat-label">Mimo 字数</text>
          </view>
        </view>
        <view class="stat-card qwen-card">
          <view class="stat-icon">🐻</view>
          <view class="stat-info">
            <text class="stat-value">{{stats.qwenChars}}</text>
            <text class="stat-label">Qwen 字数</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- users 时间选择和统计 -->
  <view class="tts-stats-section" wx:if="{{currentCollection === 'users'}}">
    <!-- 时间选择 -->
    <view class="time-filter-container">
      <view class="time-filter-header">
        <text class="time-filter-title">时间筛选</text>
      </view>
      <view class="time-filter-tabs">
        <view 
          class="time-tab {{timeFilterType === 'today' ? 'active' : ''}}" 
          bindtap="onTimeFilterChange" 
          data-type="today">
          当天
        </view>
        <view 
          class="time-tab {{timeFilterType === 'yesterday' ? 'active' : ''}}" 
          bindtap="onTimeFilterChange" 
          data-type="yesterday">
          昨天
        </view>
        <view 
          class="time-tab {{timeFilterType === 'last7days' ? 'active' : ''}}" 
          bindtap="onTimeFilterChange" 
          data-type="last7days">
          近7天
        </view>
        <view 
          class="time-tab {{timeFilterType === 'last30days' ? 'active' : ''}}" 
          bindtap="onTimeFilterChange" 
          data-type="last30days">
          近30天
        </view>
        <view 
          class="time-tab {{timeFilterType === 'custom' ? 'active' : ''}}" 
          bindtap="onTimeFilterChange" 
          data-type="custom">
          自定义
        </view>
      </view>
      <!-- 自定义日期选择 -->
      <view class="custom-date-picker" wx:if="{{timeFilterType === 'custom'}}">
        <picker mode="date" value="{{customStartDate}}" bindchange="onStartDateChange">
          <view class="date-picker-btn">
            <text>{{customStartDate || '开始日期'}}</text>
          </view>
        </picker>
        <text class="date-separator">至</text>
        <picker mode="date" value="{{customEndDate}}" bindchange="onEndDateChange">
          <view class="date-picker-btn">
            <text>{{customEndDate || '结束日期'}}</text>
          </view>
        </picker>
      </view>
      <view class="time-filter-tip">
        <text>筛选时间范围内的新注册用户</text>
      </view>
    </view>

    <!-- 统计信息 -->
    <!-- <view class="stats-container">
      <view class="stats-header">
        <text class="stats-title">统计信息</text>
        <text class="stats-period">{{statsPeriodText}}</text>
      </view>
      <view class="stats-grid stats-grid-1">
        <view class="stat-card users-card">
          <view class="stat-icon">👥</view>
          <view class="stat-info">
            <text class="stat-value">{{stats.newUsersCount}}</text>
            <text class="stat-label">新增注册用户</text>
          </view>
        </view>
      </view>
    </view> -->
  </view>

  <!-- coin_transactions 时间选择和统计 -->
  <view class="tts-stats-section" wx:if="{{currentCollection === 'coin_transactions'}}">
    <!-- 时间选择 -->
    <view class="time-filter-container">
      <view class="time-filter-header">
        <text class="time-filter-title">时间筛选</text>
      </view>
      <view class="time-filter-tabs">
        <view 
          class="time-tab {{timeFilterType === 'today' ? 'active' : ''}}" 
          bindtap="onTimeFilterChange" 
          data-type="today">
          当天
        </view>
        <view 
          class="time-tab {{timeFilterType === 'yesterday' ? 'active' : ''}}" 
          bindtap="onTimeFilterChange" 
          data-type="yesterday">
          昨天
        </view>
        <view 
          class="time-tab {{timeFilterType === 'last7days' ? 'active' : ''}}" 
          bindtap="onTimeFilterChange" 
          data-type="last7days">
          近7天
        </view>
        <view 
          class="time-tab {{timeFilterType === 'last30days' ? 'active' : ''}}" 
          bindtap="onTimeFilterChange" 
          data-type="last30days">
          近30天
        </view>
        <view 
          class="time-tab {{timeFilterType === 'custom' ? 'active' : ''}}" 
          bindtap="onTimeFilterChange" 
          data-type="custom">
          自定义
        </view>
      </view>
      <!-- 自定义日期选择 -->
      <view class="custom-date-picker" wx:if="{{timeFilterType === 'custom'}}">
        <picker mode="date" value="{{customStartDate}}" bindchange="onStartDateChange">
          <view class="date-picker-btn">
            <text>{{customStartDate || '开始日期'}}</text>
          </view>
        </picker>
        <text class="date-separator">至</text>
        <picker mode="date" value="{{customEndDate}}" bindchange="onEndDateChange">
          <view class="date-picker-btn">
            <text>{{customEndDate || '结束日期'}}</text>
          </view>
        </picker>
      </view>
      <view class="time-filter-tip">
        <text>筛选时间范围内的金币交易统计</text>
      </view>
    </view>

    <!-- 统计信息 -->
    <view class="stats-container">
      <view class="stats-header">
        <text class="stats-title">统计信息</text>
        <text class="stats-period">{{statsPeriodText}}</text>
      </view>
      <view class="stats-grid stats-grid-3">
        <view class="stat-card sign-card">
          <view class="stat-icon">📅</view>
          <view class="stat-info">
            <text class="stat-value">{{stats.signCount}}</text>
            <text class="stat-label">签到数</text>
          </view>
        </view>
        <view class="stat-card ad-card">
          <view class="stat-icon">📺</view>
          <view class="stat-info">
            <text class="stat-value">{{stats.adCount}}</text>
            <text class="stat-label">看视频广告数</text>
          </view>
        </view>
        <view class="stat-card order-card">
          <view class="stat-icon">🛒</view>
          <view class="stat-info">
            <text class="stat-value">{{stats.orderCount}}</text>
            <text class="stat-label">购买订单数</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 数据列表 -->
  <view class="data-section" wx:if="{{currentCollection}}">
    <view class="section-header">
      <text class="section-title">数据列表 ({{currentCollection}})</text>
      <text class="data-count">共 {{total}} 条</text>
    </view>
    
    <!-- 限制提示 -->
    <view class="limit-tip" wx:if="{{currentCollection === 'tts_clone_design_logs' || currentCollection === 'users' || currentCollection === 'coin_transactions' || currentCollection === 'upload_file_logs'}}">
      <text class="limit-tip-text">📌 提示：无时间筛选时，默认显示最近100条数据</text>
    </view>

    <view class="data-list" wx:if="{{dataList.length > 0}}">
      <!-- tts_clone_design_logs 扁平化展示 -->
      <view wx:if="{{currentCollection === 'tts_clone_design_logs' && flatLogsList.length >= 0}}">
        <view class="section-header">
          <text class="section-title">日志列表 (共 {{flatLogsList.length}} 条)</text>
        </view>
        <!-- logs 类型筛选 tabs -->
        <view class="log-filter-tabs">
          <view 
            class="log-filter-tab {{logFilterType === item.key ? 'active' : ''}}" 
            wx:for="{{logFilterTabs}}" 
            wx:key="key"
            bindtap="onLogFilterChange"
            data-type="{{item.key}}">
            {{item.label}}
          </view>
        </view>
        <view class="data-item log-flat-item" wx:for="{{flatLogsList}}" wx:key="_logId">
          <view class="item-row">
            <view class="item-index">{{index + 1}}</view>
            <view class="log-flat-header">
              <view class="log-flat-openid">
                <text class="log-flat-label">openid:</text>
                <text class="log-flat-value copy-text" bindtap="onCopyText" data-text="{{item.openid}}">{{item.openid}}</text>
              </view>
              <text class="log-flat-type log-type-{{item.type}}">{{item.type === 'clone' ? '克隆' : item.type === 'design' ? '设计' : item.type === 'synthesize_mimo' ? 'Mimo合成' : item.type === 'synthesize' ? 'Qwen合成' : item.type || '未知'}}</text>
            </view>
          </view>
          <view class="log-flat-body">
            <!-- 克隆类型 -->
            <block wx:if="{{item.type === 'clone'}}">
              <view class="log-flat-row">
                <text class="log-flat-label">声音:</text>
                <text class="log-flat-value copy-text" bindtap="onCopyText" data-text="{{item.voice_name}}">{{item.voice_name || '-'}}</text>
              </view>
              <view class="log-flat-row">
                <text class="log-flat-label">文本:</text>
                <text class="log-flat-value text-value copy-text" bindtap="onCopyText" data-text="{{item.text}}">{{item.text || '-'}}</text>
              </view>
              <view class="log-flat-row" wx:if="{{item.target_model}}">
                <text class="log-flat-label">模型:</text>
                <text class="log-flat-value copy-text" bindtap="onCopyText" data-text="{{item.target_model}}">{{item.target_model}}</text>
              </view>
            </block>
            <!-- 设计类型 -->
            <block wx:if="{{item.type === 'design'}}">
              <view class="log-flat-row" wx:if="{{item.voice_name}}">
                <text class="log-flat-label">声音:</text>
                <text class="log-flat-value copy-text" bindtap="onCopyText" data-text="{{item.voice_name}}">{{item.voice_name}}</text>
              </view>
              <view class="log-flat-row">
                <text class="log-flat-label">文本:</text>
                <text class="log-flat-value text-value copy-text" bindtap="onCopyText" data-text="{{item.voice_prompt || item.text}}">{{item.voice_prompt || item.text || '-'}}</text>
              </view>
              <view class="log-flat-row" wx:if="{{item.target_model}}">
                <text class="log-flat-label">模型:</text>
                <text class="log-flat-value copy-text" bindtap="onCopyText" data-text="{{item.target_model}}">{{item.target_model}}</text>
              </view>
            </block>
            <!-- 合成类型 -->
            <block wx:if="{{item.type === 'synthesize_mimo' || item.type === 'synthesize'}}">
              <view class="log-flat-row" wx:if="{{item.voice_name}}">
                <text class="log-flat-label">声音:</text>
                <text class="log-flat-value copy-text" bindtap="onCopyText" data-text="{{item.voice_name}}">{{item.voice_name}}</text>
              </view>
              <view class="log-flat-row">
                <text class="log-flat-label">文本:</text>
                <text class="log-flat-value text-value copy-text" bindtap="onCopyText" data-text="{{item.text}}">{{item.text || '-'}}</text>
              </view>
              <view class="log-flat-row" wx:if="{{item.language}}">
                <text class="log-flat-label">语言:</text>
                <text class="log-flat-value copy-text" bindtap="onCopyText" data-text="{{item.language}}">{{item.language}}</text>
              </view>
            </block>
            <view class="log-flat-row">
              <text class="log-flat-label">成本:</text>
              <text class="log-flat-value cost-value copy-text" bindtap="onCopyText" data-text="{{item.cost}}">{{item.cost || 0}}</text>
            </view>
            <view class="log-flat-row">
              <text class="log-flat-label">时间:</text>
              <text class="log-flat-value">{{item.formattedTime}}</text>
            </view>
            <view class="log-flat-row" wx:if="{{item.preview_audio_file_id}}">
              <text class="log-flat-label">音频:</text>
              <text class="log-flat-value audio-id-value" bindtap="onPlayAudio" data-audio-id="{{item.preview_audio_file_id}}">▶ 播放并复制链接</text>
            </view>
            <view class="log-flat-row" wx:if="{{item.audio_file_id && !item.preview_audio_file_id}}">
              <text class="log-flat-label">音频:</text>
              <text class="log-flat-value audio-id-value" bindtap="onPlayAudio" data-audio-id="{{item.audio_file_id}}">▶ 播放并复制链接</text>
            </view>
          </view>
          </view>
        </view>
      </view>

      <!-- upload_file_logs 专用展示 -->
      <view wx:if="{{currentCollection === 'upload_file_logs'}}">
        <view class="data-item upload-item" wx:for="{{dataList}}" wx:key="_id" bindtap="onViewItem" data-index="{{index}}">
          <view class="item-row">
            <view class="item-index">{{index + 1}}</view>
            <view class="upload-item-header">
            <text class="data-id">ID: {{item._id}}</text>
            <text class="data-action">点击编辑</text>
          </view>

          <view class="upload-item-body">
            <view class="upload-field">
              <text class="upload-label">openid:</text>
              <text class="upload-value openid-value copy-text" bindtap="onCopyText" data-text="{{item.openid}}">{{item.openid || '-'}}</text>
            </view>
            <view class="upload-field">
              <text class="upload-label">file_ID:</text>
              <text class="upload-value file-id-value copy-text" bindtap="onCopyText" data-text="{{item.file_id}}">{{item.file_id || '-'}}</text>
            </view>
            <view class="upload-field">
              <text class="upload-label">date:</text>
              <text class="upload-value">{{item.formattedTime}}</text>
            </view>
          </view>
          </view>
        </view>
      </view>

      <!-- api_key_usage 专用展示 -->
      <view wx:if="{{currentCollection === 'api_key_usage'}}">
        <view class="data-item apikey-item" wx:for="{{dataList}}" wx:key="_id">
          <view class="item-row">
            <view class="item-index">{{index + 1}}</view>
            <view class="apikey-item-header">
              <text class="data-id">ID: {{item._id}}</text>
            </view>
          </view>

          <view class="apikey-item-body">
            <!-- Clone Usage -->
            <view class="apikey-section">
              <view class="apikey-section-title">克隆使用统计</view>
              <view class="apikey-stats">
                <view class="apikey-stat">
                  <text class="apikey-stat-label">key_num:</text>
                  <text class="apikey-stat-value editable-value" bindtap="onEditApiKeyField" data-index="{{index}}" data-usage="clone_usage" data-field="key_num">{{item.clone_usage.key_num || 0}}</text>
                </view>
                <view class="apikey-stat">
                  <text class="apikey-stat-label">key_v_num:</text>
                  <text class="apikey-stat-value editable-value" bindtap="onEditApiKeyField" data-index="{{index}}" data-usage="clone_usage" data-field="key_v_num">{{item.clone_usage.key_v_num || 0}}</text>
                </view>
                <view class="apikey-stat">
                  <text class="apikey-stat-label">key_w_num:</text>
                  <text class="apikey-stat-value editable-value" bindtap="onEditApiKeyField" data-index="{{index}}" data-usage="clone_usage" data-field="key_w_num">{{item.clone_usage.key_w_num || 0}}</text>
                </view>
              </view>
            </view>

            <!-- Design Usage -->
            <view class="apikey-section">
              <view class="apikey-section-title">设计使用统计</view>
              <view class="apikey-stats">
                <view class="apikey-stat">
                  <text class="apikey-stat-label">key_num:</text>
                  <text class="apikey-stat-value editable-value" bindtap="onEditApiKeyField" data-index="{{index}}" data-usage="design_usage" data-field="key_num">{{item.design_usage.key_num || 0}}</text>
                </view>
                <view class="apikey-stat">
                  <text class="apikey-stat-label">key_v_num:</text>
                  <text class="apikey-stat-value editable-value" bindtap="onEditApiKeyField" data-index="{{index}}" data-usage="design_usage" data-field="key_v_num">{{item.design_usage.key_v_num || 0}}</text>
                </view>
                <view class="apikey-stat">
                  <text class="apikey-stat-label">key_w_num:</text>
                  <text class="apikey-stat-value editable-value" bindtap="onEditApiKeyField" data-index="{{index}}" data-usage="design_usage" data-field="key_w_num">{{item.design_usage.key_w_num || 0}}</text>
                </view>
              </view>
            </view>

            <!-- 更新时间 -->
            <view class="apikey-time">
              <text class="apikey-time-label">更新时间:</text>
              <text class="apikey-time-value">{{item.updated_at_formatted}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- api_key_usage 编辑弹窗 -->
      <view class="modal-mask" wx:if="{{showApiKeyEditModal}}" bindtap="onCloseApiKeyEditModal">
        <view class="modal-content apikey-edit-modal" catchtap>
          <view class="modal-header">
            <text class="modal-title">编辑字段</text>
            <view class="modal-close" bindtap="onCloseApiKeyEditModal">✕</view>
          </view>

          <view class="modal-body">
            <view class="edit-field">
              <text class="field-label">{{apiKeyEditLabel}}</text>
              <input
                class="field-input"
                type="number"
                value="{{apiKeyEditValue}}"
                bindinput="onApiKeyFieldInput"
              />
            </view>
          </view>

          <view class="modal-footer">
            <button class="btn btn-secondary" bindtap="onCloseApiKeyEditModal">取消</button>
            <button class="btn btn-primary" bindtap="onSaveApiKeyField">保存</button>
          </view>
        </view>
      </view>

      <!-- coin_transactions 扁平化展示 -->
      <view wx:if="{{currentCollection === 'coin_transactions' && flatCoinsList.length > 0}}">
        <view class="section-header">
          <text class="section-title">交易列表 (共 {{flatCoinsList.length}} 条)</text>
        </view>
        <!-- coins 类型筛选 tabs -->
        <view class="coin-filter-tabs">
          <view 
            class="coin-filter-tab {{coinFilterType === item.key ? 'active' : ''}}" 
            wx:for="{{coinFilterTabs}}" 
            wx:key="key"
            bindtap="onCoinFilterChange"
            data-type="{{item.key}}">
            {{item.label}}
          </view>
        </view>
        <view class="data-item coin-flat-item" wx:for="{{flatCoinsList}}" wx:key="_transId">
          <view class="item-row">
            <view class="item-index">{{index + 1}}</view>
            <view class="coin-flat-header">
              <view class="coin-flat-openid">
                <text class="coin-flat-label">openid:</text>
                <text class="coin-flat-value copy-text" bindtap="onCopyText" data-text="{{item.openid}}">{{item.openid}}</text>
              </view>
              <text class="coin-flat-type coin-type-{{item.type}}">{{item.type === 'spend' ? '消费' : item.type === 'charge' ? '充值' : item.type || '未知'}}</text>
              <text class="coin-flat-amount coin-amount-{{item.type}}">{{item.type === 'spend' ? '-' : '+'}}{{item.amount || 0}}</text>
            </view>
          </view>
          <view class="coin-flat-body">
            <view class="coin-flat-row">
              <text class="coin-flat-label">余额:</text>
              <text class="coin-flat-value">{{item.balance || 0}}</text>
            </view>
            <view class="coin-flat-row" wx:if="{{item.description}}">
              <text class="coin-flat-label">描述:</text>
              <text class="coin-flat-value">{{item.description}}</text>
            </view>
            <view class="coin-flat-row" wx:if="{{item.source}}">
              <text class="coin-flat-label">来源:</text>
              <text class="coin-flat-value">{{item.source}}</text>
            </view>
            <view class="coin-flat-row" wx:if="{{item.source_id}}">
              <text class="coin-flat-label">来源ID:</text>
              <text class="coin-flat-value source-id-value copy-text" bindtap="onCopyText" data-text="{{item.source_id}}">{{item.source_id}}</text>
            </view>
            <view class="coin-flat-row">
              <text class="coin-flat-label">时间:</text>
              <text class="coin-flat-value">{{item.formattedTime}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- users 简化展示 -->
      <view wx:if="{{currentCollection === 'users'}}">
        <view class="data-item user-simple-item" wx:for="{{dataList}}" wx:key="_id">
          <view class="item-row">
            <view class="item-index">{{index + 1}}</view>
            <view class="user-simple-header">
              <text class="user-simple-openid copy-text" bindtap="onCopyText" data-text="{{item.openid}}">{{item.openid || '-'}}</text>
              <text class="user-simple-status user-status-{{item.status}}">{{item.status || '-'}}</text>
            </view>
          </view>
          <view class="user-simple-body">
            <view class="user-simple-field" wx:if="{{item.agreedToTerms !== undefined}}">
              <text class="user-simple-label">同意条款:</text>
              <text class="user-simple-value {{item.agreedToTerms ? 'status-agreed' : 'status-disagreed'}}">{{item.agreedToTerms ? '✓' : '✗'}}</text>
            </view>
            <view class="user-simple-field" wx:if="{{item.refund_id}}">
              <text class="user-simple-label">退款:</text>
              <text class="user-simple-value">{{item.refund_status || '有退款'}}</text>
            </view>
            <view class="user-simple-field">
              <text class="user-simple-label">注册:</text>
              <text class="user-simple-value">{{item.created_at_formatted}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 其他集合的通用展示 -->
      <view wx:if="{{currentCollection !== 'tts_clone_design_logs' && currentCollection !== 'upload_file_logs' && currentCollection !== 'api_key_usage' && currentCollection !== 'coin_transactions' && currentCollection !== 'users'}}">
        <view class="data-item" wx:for="{{dataList}}" wx:key="_id" bindtap="onViewItem" data-index="{{index}}">
          <view class="item-row">
            <view class="item-index">{{index + 1}}</view>
            <view class="data-item-header">
            <text class="data-id">ID: {{item._id}}</text>
            <text class="data-action">点击编辑</text>
          </view>
          <view class="data-item-body">
            <view class="data-field" wx:for="{{item}}" wx:for-item="val" wx:for-index="key" wx:key="key">
              <text class="field-key">{{key}}:</text>
              <text class="field-value">{{formatValue(val)}}</text>
            </view>
          </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{hasMore}}" bindtap="onLoadMore">
      <text>{{loading ? '加载中...' : '加载更多'}}</text>
    </view>

    <!-- 没有更多数据 -->
    <view class="no-more" wx:if="{{!hasMore && dataList.length > 0}}">
      <text>没有更多数据了</text>
    </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!currentCollection}}">
    <view class="empty-icon">🗄️</view>
    <text class="empty-text">请选择数据表</text>
  </view>

  <view class="empty-state" wx:if="{{currentCollection && !loading && dataList.length === 0}}">
    <view class="empty-icon">📭</view>
    <text class="empty-text">暂无数据</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 编辑弹窗 -->
  <view class="modal-mask" wx:if="{{showEditModal}}" bindtap="onCloseModal">
    <view class="modal-content" catchtap>
      <view class="modal-header">
        <text class="modal-title">编辑数据</text>
        <view class="modal-close" bindtap="onCloseModal">✕</view>
      </view>

      <view class="modal-body">
        <view class="edit-field" wx:for="{{editData}}" wx:for-item="val" wx:for-index="key" wx:key="key">
          <text class="field-label">{{key}}</text>
          <textarea
            class="field-textarea"
            value="{{formatValue(val)}}"
            bindinput="onEditFieldInput"
            data-field="{{key}}"
            auto-height
          />
        </view>
      </view>

      <view class="modal-footer">
        <button class="btn btn-danger" bindtap="onDelete">删除</button>
        <button class="btn btn-primary" bindtap="onSave">保存</button>
      </view>
    </view>
  </view>
</view>
