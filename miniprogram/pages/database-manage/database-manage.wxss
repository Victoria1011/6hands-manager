.container {
  min-height: 100vh;
  background: #F6F6F6;
  padding: 20rpx;
}

/* 点击复制样式 */
.copy-text {
  color: #1890ff;
  text-decoration: underline;
}
.copy-text:active {
  opacity: 0.6;
}

/* 列表序号 */
.item-index {
  width: 56rpx;
  min-width: 56rpx;
  height: 56rpx;
  background: #1890ff;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* 序号和内容同一行 */
.item-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

/* 集合选择 */
.collection-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  width: 100%;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

/* 快捷标签 */
.quick-tags {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.quick-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 28rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  border: 2rpx solid #e8e8e8;
  transition: all 0.3s;
}

.quick-tag:active {
  transform: scale(0.95);
}

.quick-tag.active {
  background: #e3f2fd;
  border-color: #1890ff;
}

.tag-icon {
  font-size: 28rpx;
}

.tag-text {
  font-size: 26rpx;
  color: #666;
}

.quick-tag.active .tag-text {
  color: #1890ff;
  font-weight: 600;
}

.picker-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
  transition: all 0.3s;
}

.picker-container:active {
  background: #ebebeb;
  border-color: #1890ff;
}

.picker-text {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.picker-placeholder {
  color: #999;
}

.picker-arrow {
  font-size: 24rpx;
  color: #999;
  margin-left: 16rpx;
}

/* 搜索 */
.search-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.search-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.search-field-wrapper,
.search-value-wrapper {
  flex: 1;
}

.search-input {
  width: 100%;
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
  border: none;
}

.search-btn {
  padding: 16rpx 30rpx;
  background: #1890ff;
  color: #fff;
  border: none;
  border-radius: 8rpx;
  font-size: 28rpx;
}

/* 数据列表 */
.data-section {
  width: 90%;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.data-count {
  font-size: 26rpx;
  color: #999;
}

.data-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.data-item {
  background: #fafafa;
  border-radius: 12rpx;
  padding: 24rpx;
  border: 2rpx solid #f0f0f0;
  transition: all 0.3s;
}

.data-item:active {
  background: #f0f0f0;
  transform: scale(0.98);
}

.data-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #e8e8e8;
}

.data-id {
  font-size: 24rpx;
  color: #666;
  font-family: monospace;
}

.data-action {
  font-size: 24rpx;
  color: #1890ff;
}

.data-item-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.data-field {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
  font-size: 24rpx;
}

.field-key {
  color: #666;
  min-width: 140rpx;
  flex-shrink: 0;
}

.field-value {
  color: #333;
  flex: 1;
  word-break: break-all;
  font-family: monospace;
  font-size: 22rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx;
  color: #1890ff;
  font-size: 28rpx;
}

.load-more:active {
  opacity: 0.6;
}

.no-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  width: 100%;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 16rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 85%;
  max-height: 80vh;
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
  cursor: pointer;
}

.modal-close:active {
  color: #666;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 30rpx;
}

.edit-field {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.field-textarea {
  width: 100%;
  min-height: 80rpx;
  padding: 16rpx;
  background: #f5f5f5;
  border: 2rpx solid #e8e8e8;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333;
  font-family: monospace;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 30rpx;
  border-top: 2rpx solid #f0f0f0;
}

.btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  border: none;
}

.btn-danger {
  background: #ff4d4f;
  color: #fff;
}

.btn-primary {
  background: #1890ff;
  color: #fff;
}

/* TTS Clone Logs 专用样式 */
.tts-item {
  background: #f9fbfd;
  border-color: #e3f2fd;
}

.logs-count {
  font-size: 24rpx;
  color: #1890ff;
  font-weight: 600;
}

.expand-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  background: #e3f2fd;
  border-radius: 8rpx;
  margin-bottom: 0;
  transition: all 0.3s;
}

.expand-btn:active {
  background: #bbdefb;
}

.expand-btn text {
  font-size: 24rpx;
  color: #1890ff;
}

.logs-container {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-top: 16rpx;
  margin-top: 16rpx;
  border-top: 2rpx dashed #e3f2fd;
}

.log-item {
  background: #fff;
  border-radius: 8rpx;
  padding: 20rpx;
  border: 2rpx solid #e8e8e8;
}

.log-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.log-voice {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.log-status {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-completed {
  background: #e8f5e9;
  color: #4caf50;
}

.status-failed {
